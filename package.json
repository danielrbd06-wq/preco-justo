{
  "name": "preco-justo",
  "private": true,
  "version": "1.1.0",
  "description": "Precificação e gestão gerencial para salões de beleza, barbearias e estúdios de beleza da Bahia.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --config vite.single.config.js",
