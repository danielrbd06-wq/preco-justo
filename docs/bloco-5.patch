+/* mantêm a taxa que já tinham.                                              */
+function taxaEfetiva(servico, nd) {
+  if (servico?.taxaModo === "negocio" && nd?.taxaRecebimento) return nd.taxaRecebimento.pct;
+  return N(servico?.taxaCartaoPct);
+}
