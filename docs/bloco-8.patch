+# Esteira de qualidade (Bloco 8): roda em todo Pull Request para a main e em
+# todo merge. Se as contas, o build ou o teste no navegador falharem, o PR fica
+# marcado com ❌ e (com a regra de proteção da main) o merge é bloqueado.
+name: Qualidade
+
+on:
+  pull_request:
+    branches: [main]
+  push:
+    branches: [main]
+
+permissions:
+  contents: read
+
+concurrency:
+  group: qualidade-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  testes:
+    name: Testes e build
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+
+      - name: Instalar dependências
+        run: npm ci
+
+      - name: Testes das contas (Vitest, com cobertura mínima)
